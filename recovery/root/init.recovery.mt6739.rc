# Baseado no init.recovery.mt6739.rc do recovery stock do A022M.
# Ajustes para o TWRP: o kernel usa USB configfs, e o init.rc do TWRP comeca
# com sys.usb.configfs=0; sys.usb.controller vem do getprop do aparelho.

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 0
    setprop sys.usb.controller musb-hdrc

on fs
    # MTK: tratar a porta como dados (SDP) e nao so carga. No stock isso so
    # roda com ro.debuggable=0; o build eng do TWRP tem ro.debuggable=1.
    write /sys/class/udc/musb-hdrc/device/cmode 2
