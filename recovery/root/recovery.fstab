# <mount point>  <fstype>  <device>  [<device2>]  <flags>
# Baseado no fstab.mt6739 do vendor do A022M (firmware A022MUBS4BWL2).

# Particoes dinamicas (dentro do super)
/system             ext4      system                                                    flags=display=System;logical
/vendor             ext4      vendor                                                    flags=display=Vendor;logical
/product            ext4      product                                                   flags=display=Product;logical
/odm                ext4      odm                                                       flags=display=Odm;logical
/super              emmc      /dev/block/platform/bootdevice/by-name/super              flags=display=Super;backup=0;flashimg=1

# Boot e recovery
/boot               emmc      /dev/block/platform/bootdevice/by-name/boot               flags=display=Boot;flashimg=1
/recovery           emmc      /dev/block/platform/bootdevice/by-name/recovery           flags=display=Recovery;flashimg=1
/dtbo               emmc      /dev/block/platform/bootdevice/by-name/dtbo               flags=display=Dtbo;backup=1;flashimg=1
/vbmeta             emmc      /dev/block/platform/bootdevice/by-name/vbmeta             flags=display=Vbmeta;backup=1;flashimg=1
/vbmeta_vendor      emmc      /dev/block/platform/bootdevice/by-name/vbmeta_vendor      flags=display=Vbmeta_vendor;backup=1;flashimg=1
/vbmeta_samsung     emmc      /dev/block/platform/bootdevice/by-name/vbmeta_samsung     flags=display=Vbmeta_samsung;backup=1;flashimg=1

# Dados (f2fs). Sem flag de criptografia na primeira build.
# Para ligar FBE depois: acrescentar ;fileencryption=aes-256-xts:aes-256-cts:v1
/data               f2fs      /dev/block/platform/bootdevice/by-name/userdata           flags=display=Data;wipeingui
/cache              ext4      /dev/block/platform/bootdevice/by-name/cache              flags=display=Cache;wipeingui
/metadata           ext4      /dev/block/platform/bootdevice/by-name/md_udc             flags=display=Metadata

# Particoes de identidade/radio: backup bruto (imagem), sem montar
# TODO: conferir no PIT os nomes efs, sec_efs e frp/persistent
/nvram              emmc      /dev/block/platform/bootdevice/by-name/nvram              flags=display=Nvram;backup=1
/nvdata             emmc      /dev/block/platform/bootdevice/by-name/nvdata             flags=display=Nvdata;backup=1
/nvcfg              emmc      /dev/block/platform/bootdevice/by-name/nvcfg              flags=display=Nvcfg;backup=1
/protect1           emmc      /dev/block/platform/bootdevice/by-name/protect1           flags=display=Protect1;backup=1
/protect2           emmc      /dev/block/platform/bootdevice/by-name/protect2           flags=display=Protect2;backup=1
/proinfo            emmc      /dev/block/platform/bootdevice/by-name/proinfo            flags=display=Proinfo;backup=1
/efs                emmc      /dev/block/platform/bootdevice/by-name/efs                flags=display=Efs;backup=1
/sec_efs            emmc      /dev/block/platform/bootdevice/by-name/sec_efs            flags=display=Sec_efs;backup=1
/persistent         emmc      /dev/block/platform/bootdevice/by-name/frp                flags=display=Persistent;backup=1

# Armazenamento removivel
/external_sd        auto      /dev/block/mmcblk1p1  /dev/block/mmcblk1                  flags=display="MicroSD";storage;wipeingui;removable
/usb_otg            auto      /dev/block/sda1       /dev/block/sda                      flags=display="USB OTG";storage;wipeingui;removable
